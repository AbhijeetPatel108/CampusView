{
  "name": "clubviews-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client--",
    "server"
  ],
  "scripts": {
    "postinstall": "npm install --prefix client--",
    "dev": "npm run dev --prefix client--",
    "build": "npm install --prefix client-- && npm run build --prefix client--",
    "start": "npm run start --prefix server",
    "lint": "npm run lint --prefix client--"
  }
}
